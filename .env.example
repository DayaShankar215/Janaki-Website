# ─────────────────────────────────────────────────────────────
# EmailJS configuration — https://www.emailjs.com/
# 1. Create a free EmailJS account.
# 2. Add an email service (e.g. Gmail) → copy the SERVICE ID.
# 3. Create an email template → copy the TEMPLATE ID.
# 4. Copy your PUBLIC KEY from Account → API Keys.
# 5. Rename this file to ".env" and fill in the values below.
#
# NOTE: Only the PUBLIC key lives here — never put private
# email account passwords or secret keys in this project.
# ─────────────────────────────────────────────────────────────

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Admin panel password (page /admin). Change this before going live!
VITE_ADMIN_PASSWORD=janaki-admin
